// Anywhere in a trip (setting.sight_walk is on every SightWalk view), the
// swap-line keys ask for the next or previous step; ctrl+s switches whether the
// wheel over Map and Holiday moves the whole trip.
[
    {"keys": ["ctrl+s"], "command": "sight_walk_toggle_panning", "context": [{"key": "setting.sight_walk"}]},
    {"keys": ["ctrl+super+down"], "command": "sight_walk_ask", "args": {"text": "Explain next."}, "context": [{"key": "setting.sight_walk"}]},
    {"keys": ["ctrl+super+up"], "command": "sight_walk_ask", "args": {"text": "Explain previous."}, "context": [{"key": "setting.sight_walk"}]}
]
