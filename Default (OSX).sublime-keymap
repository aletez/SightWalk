// Anywhere in a trip or the Vetting strip (setting.sight_walk is on every SightWalk view), the
// swap-line keys ask for the next or previous step.
[
    {"keys": ["ctrl+super+down"], "command": "sight_walk_ask", "args": {"text": "Explain next."}, "context": [{"key": "setting.sight_walk"}]},
    {"keys": ["ctrl+super+up"], "command": "sight_walk_ask", "args": {"text": "Explain previous."}, "context": [{"key": "setting.sight_walk"}]}
]
