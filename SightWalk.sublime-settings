{
    // The language of SightWalk's words (headers, tabs, buttons, notes): "en" or "pl".
    // "SightWalk: Switch Language" in the command palette switches it.
    "language": "en",

    // Port of the local bridge. The token is written to your User settings by the setup command.
    "port": 47321,

    // The header band and the gutter in the file's hue, as a share of a fully saturated colour
    // (0 to 1). New values apply to the next reader window.
    "tint": 0.25,

    // Bottom of the conversation pane, as a share of the window's height. The pane below it is
    // kept for what comes next.
    "default_conversation_height": 0.6,

    // Where the Vetting Bench (the conversation) sits: "left" or "right" of the Sights.
    "bench_side": "left",

    // Blocks whose opening line stays frozen under a sight's header, one low pane per line, so
    // you see which class (or loop…) a method belongs to. Any of "class", "def", "if", "for",
    // "with"; the next trip uses a new list.
    "frozen_parents": ["class", "def"],

    // How far ▲ and ▼ on the scroll strip move the trip, as a share of the screen.
    "strip_step": 0.15,

    // The bench's font, proportional for easier reading: one font, or one per system; "" keeps
    // your editor's font. Its size is set per syntax: in "SightWalkChat.sublime-settings"
    // (Preferences → Settings – Syntax Specific, with the cursor on a bench).
    "bench_font_face": {"osx": "Charter", "windows": "Segoe UI", "linux": "Noto Sans"},

    // Where Graphviz's dot is, if SightWalk cannot find it to draw the Map tab.
    // "dot_path": "/opt/homebrew/bin/dot",

    // Where Claude Code is, if SightWalk cannot find it to start the guide.
    // "claude_path": "~/.local/bin/claude",
    // One colour scheme for every view of a trip (SightWalk: Select Colour Scheme): light_ or
    // dark_color_scheme by the system's style, else color_scheme; none keeps Sublime's own.
    // "color_scheme": "Mariana.sublime-color-scheme",
    // "light_color_scheme": "Breakers.sublime-color-scheme",
    // "dark_color_scheme": "Mariana.sublime-color-scheme",
}
