%YAML 1.2
---
# A sight's header: its name greyed (Jakub; the colour is in SightWalk's header scheme, see
# tint), then its file and lines. Only for display.
name: SightWalk Sight Header
scope: text.sight-walk.header
hidden: true
contexts:
  main:
    - match: '^\s*([a-z]+(?: \d+)?)(\s*·)'
      captures:
        1: meta.sight-name.sight-walk
        2: meta.sight-name.sight-walk
