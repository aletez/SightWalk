%YAML 1.2
---
# A sight's header: its name greyed, the comments' colour of the scheme (Jakub), then its file
# and lines. Only for display.
name: SightWalk Sight Header
scope: text.sight-walk.header
hidden: true
contexts:
  main:
    - match: '^\s*([a-z]+(?: \d+)?)(\s*·)'
      captures:
        1: comment.line.sight-name.sight-walk
        2: comment.line.sight-name.sight-walk
